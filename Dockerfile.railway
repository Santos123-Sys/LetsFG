# LetsFG read-only MCP gateway for Railway.
# This is the public-client integration, not a self-host of letsfg.co's backend.
FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY sdk/mcp/package.json sdk/mcp/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY sdk/mcp/tsconfig.json ./
COPY sdk/mcp/src/ ./src/
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY --from=build /build/dist/index.js ./mcp/index.js
COPY deploy/railway-gateway.cjs ./railway-gateway.cjs
USER node
EXPOSE 3000
CMD ["node", "railway-gateway.cjs"]
